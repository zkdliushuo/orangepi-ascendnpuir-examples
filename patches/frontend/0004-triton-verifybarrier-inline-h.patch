--- a/bishengir/triton/include/triton/Dialect/TritonNvidiaGPU/Transforms/Utility.h
+++ b/bishengir/triton/include/triton/Dialect/TritonNvidiaGPU/Transforms/Utility.h
@@ -6,8 +6,17 @@
 
 namespace mlir::triton::nvidia_gpu {
 
-LogicalResult verifyBarrierType(Operation *op,
-                                mlir::triton::gpu::MemDescType barrierType);
+// Defined inline: this helper is used by the IR library (TritonNvidiaGPUIR)
+// while its out-of-line definition lived in TritonNvidiaGPUTransforms, which
+// the linker visits before the IR archive and therefore cannot satisfy.
+inline LogicalResult
+verifyBarrierType(Operation *op, mlir::triton::gpu::MemDescType barrierType) {
+  if (!barrierType.getElementType().isInteger(64) ||
+      barrierType.getShape() != ArrayRef<int64_t>({1}))
+    return op->emitOpError(
+        "barrier allocation must be a descriptor of 1xi64 type");
+  return success();
+}
 
 }
 
